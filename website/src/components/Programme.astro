---
// The download list, set like a concert programme: one line per plug-in, where it comes from, and the action. A
// released plug-in shows its version and downloads; one without a release yet builds from source.
import Arrow from "./Arrow.astro";
import { getAction, products } from "../data/products";
---
<ol class="programme">
  {products.map((p) => {
    const get = getAction(p);
    return (
      <li class="programme__row" data-product={p.code}>
        <a class="programme__name" href={`/${p.code}`}>{p.name}</a>
        <span class="programme__meta t-small num">{[p.version ?? "From source", p.platformNote].filter(Boolean).join(", ")}</span>
        <a class="programme__get" href={get.href} aria-label={get.named} data-external={get.arrow === "out" ? "" : undefined}>
          {p.version ? "Download" : "Build"} <Arrow dir={get.arrow} />
        </a>
      </li>
    );
  })}
</ol>

<style>
  .programme {
    border-top: 1.5px solid var(--ink);
  }
  .programme__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "name get" "meta get";
    align-items: center;
    column-gap: var(--s5);
    padding-block: var(--s3) calc(var(--s3) + 1px);
    border-bottom: 1px solid var(--rule);
    position: relative;
  }
  .programme__row::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    width: 0;
    height: 1.5px;
    background: var(--spot);
    transition: width 0.6s var(--ease-out);
  }
  .programme__row:hover::before,
  .programme__row:focus-within::before {
    width: 100%;
  }
  .programme__name {
    grid-area: name;
    font-stretch: 112%;
    font-weight: 450;
    font-size: 1.1875rem;
    letter-spacing: -0.012em;
    text-decoration: none;
  }
  .programme__meta {
    grid-area: meta;
  }
  .programme__get {
    grid-area: get;
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-weight: 500;
    font-stretch: 108%;
    font-size: 0.9375rem;
    text-decoration: none;
    padding: var(--s2) 0 var(--s2) var(--s3);
  }
  .programme__get :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.45s var(--ease-out);
  }
  .programme__get:hover :global(svg) {
    transform: translateY(2px);
  }
  .programme__get[data-external]:hover :global(svg) {
    transform: translate(2px, -2px);
  }
</style>
