---
// A figure control: label, value in tabular figures, and a hairline range. The value is formatted in the browser.
interface Props {
  name: string;
  label: string;
  min: number;
  max: number;
  step: number;
  value: number;
  display: string;
}
const { name, label, min, max, step, value, display } = Astro.props;
const id = `ctl-${name}-${Math.random().toString(36).slice(2, 7)}`;
---
<div class="control">
  <label class="control__label" for={id}>{label}</label>
  <output class="control__value num" for={id} data-out={name}>{display}</output>
  <input id={id} class="control__range" type="range" name={name} min={min} max={max} step={step} value={value} aria-valuetext={display} />
</div>

<style>
  .control {
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: var(--s1);
    align-items: baseline;
  }
  .control__label {
    font-size: 0.9375rem;
    font-weight: 450;
    font-stretch: 108%;
  }
  .control__value {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .control__range {
    grid-column: 1 / -1;
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: 28px;
    margin: 0;
    background: linear-gradient(var(--rule-strong), var(--rule-strong)) center / 100% 1px no-repeat;
    cursor: ew-resize;
  }
  .control__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    background: var(--ink);
    border: 0;
    border-radius: 0;
    transition: transform 0.25s var(--ease-out), background 0.2s;
  }
  .control__range::-moz-range-thumb {
    width: 14px;
    height: 14px;
    background: var(--ink);
    border: 0;
    border-radius: 0;
  }
  .control__range:hover::-webkit-slider-thumb,
  .control__range:active::-webkit-slider-thumb {
    background: var(--spot);
    transform: rotate(45deg);
  }
  .control__range:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
</style>
