---
import Base from "../layouts/Base.astro";
import ProductHero from "../components/ProductHero.astro";
import Section from "../components/Section.astro";
import Features from "../components/Features.astro";
import Gestures from "../components/Gestures.astro";
import Plate from "../components/Plate.astro";
import Readings from "../components/Readings.astro";
import Close from "../components/Close.astro";
import DialogueFigure from "../components/figures/DialogueFigure.astro";
import { product } from "../data/products";

const p = product("dialogue");
---
<Base title="Altvane Dialogue: neural dialogue isolation" description={p.summary} product="dialogue" image={p.editor}>
  <ProductHero product={p}>
    <DialogueFigure controls rows={26} />
  </ProductHero>

  <Section id="features" title="What it does" note="Pull a voice out of a noisy location recording, dry out a reverberant room, or keep only the room for an M&E track.">
    <Features
      items={[
        { lead: "Three levels", text: "Voice, Ambience and Reverb, each from Off to +12 dB. The stems always add up to the input, so with every level at 0 dB the plug-in is transparent, sample for sample." },
        { lead: "See what you keep", text: "The spectrum stacks what each stem keeps at its level, under a faint outline of the input: turn the ambience down and its layer shrinks. Solo a stem, or press Removed to hear exactly what is being taken away." },
        { lead: "Stems on their own outputs", text: "Turn on the plug-in's Voice, Ambience and Reverb outputs in your host and each stem arrives on its own channels, at its level and the output gain, to mix on its own track. Together they add up to the main output." },
        { lead: "Sensitivity across the spectrum", text: "Each stem has a six-point curve from 120 Hz to 11 kHz. Raise the voice's curve at the top to keep consonants, or raise the ambience's at the bottom to clear rumble and wind." },
        { lead: "Linked, Stereo or Mid/Side", text: "Eco or High quality. Linked runs one analysis of the mid and applies it to both channels; Stereo analyses each channel on its own; Mid/Side analyses the mid and the side on their own, for centred dialogue in a wide ambience. 44.1–192 kHz, mono or stereo." },
        { lead: "Latency your host can trust", text: "A fixed, reported latency of 70.6 ms at 48 kHz and 512-sample blocks, 60 ms of it the model's frame and look-ahead, compensated exactly by your host. Offline bounces wait for the model; in real time, a frame that would be late plays unprocessed instead of dropping out." },
        { lead: "Everything else, done properly", text: "Presets with a factory set, A/B compare, undo and redo, adjustable interface size and accent colour, keyboard control, screen-reader support and host parameter menus." },
      ]}
    />
  </Section>

  <Section id="editor" title="The editor" note="Hero knobs in the stems' colours, the spectrum above, and quality, stereo mode, latency and output in the footer.">
    <Plate {...p.editor!} caption="Altvane Dialogue, from an earlier build: Mid/Side has since joined the stereo modes, and the 80.0 ms its footer reads is now 70.6 ms." />
  </Section>

  <Section id="how" title="How it works">
    <div class="prose">
      <p class="t-body">
        The separation runs at 48 kHz on 20 ms frames with a 10 ms hop. A causal speech-enhancement network,
        <a href="https://huggingface.co/Ceva-IP/DPDFNet">DPDFNet</a> by Ceva, estimates the speech in each frame (Eco
        runs the 2-layer model, High the 8-layer one), and what it leaves is the ambience. The late reverb of the voice
        is then predicted from the voice's energy 50 ms earlier and taken from both in proportion.
      </p>
      <p class="t-body">
        Other sample rates are converted to 48 kHz and back, and what that round trip loses (everything above about
        20 kHz) is added back from the input, following the ambience level. The network is Altvane's own C++
        implementation, with the large matrix products on Apple's Accelerate on macOS, and its weights are built into
        the plug-in, so there are no files to install at run time. Stereo and Mid/Side run two analyses, computed
        together so each weight is read once per frame.
      </p>
    </div>
  </Section>

  <Section id="gestures" title="Under the hand" note="Sensitivity moves sound between stems; the stems still add up to the input.">
    <Gestures
      rows={[
        ["Change a level", "Drag the knob (<kbd>Shift</kbd> for fine), scroll, or double-click the value and type <kbd>-12</kbd> or <kbd>off</kbd>"],
        ["Reset a level", "<kbd>Cmd</kbd>-click or double-click the knob"],
        ["Hear one stem", "The headphones under its knob"],
        ["Hear what is removed", "Removed, in the footer"],
        ["Shape a stem's sensitivity", "The curve button under its knob, then drag the nodes; double-click a node to reset it, <kbd>Esc</kbd> to close"],
        ["Undo and redo", "<kbd>Cmd Z</kbd> and <kbd>Shift Cmd Z</kbd>"],
      ]}
    />
  </Section>

  <Section id="specs" title="Specifications" note="Separation is scored as SDR on a synthetic room with known parts: speech, its reflections and reverb, rumble, hum and hiss. High quality, Linked.">
    <Readings
      size="large"
      items={[
        { value: "11.9 dB", label: "voice stem against the dry voice; the input scores 6.3 dB" },
        { value: "113.8 dB", label: "the stems summed against the input, float precision" },
        { value: "70.6 ms", label: "latency at 48 kHz, 64- to 512-sample blocks" },
      ]}
    />
    <div class="spec-table">
      <Readings
        items={[
          { value: "74.1 ms", label: "latency at 44.1 kHz, 512-sample blocks" },
          { value: "71.4 ms", label: "latency at 96 kHz, 512-sample blocks" },
          { value: "44.1–192", label: "kHz, mono or stereo" },
          { value: "macOS, Windows", label: "macOS 11+ on Apple silicon and Intel, Windows x64; VST3, AU, LV2, Standalone" },
        ]}
      />
    </div>
  </Section>

  <Close product={p} />
</Base>

<style>
  .prose {
    display: grid;
    gap: var(--s4);
  }
  .spec-table {
    margin-top: var(--s6);
  }
</style>
