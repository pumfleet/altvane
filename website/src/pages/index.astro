---
import Base from "../layouts/Base.astro";
import EqFigure from "../components/figures/EqFigure.astro";
import Programme from "../components/Programme.astro";
import DialogueFigure from "../components/figures/DialogueFigure.astro";
import CompressorFigure from "../components/figures/CompressorFigure.astro";
import LimiterFigure from "../components/figures/LimiterFigure.astro";
import DeEsserFigure from "../components/figures/DeEsserFigure.astro";
import LevelerFigure from "../components/figures/LevelerFigure.astro";
import Readings from "../components/Readings.astro";
import Builds from "../components/Builds.astro";
import Arrow from "../components/Arrow.astro";
import { type Product, REPO, getAction, product } from "../data/products";

const eq = product("eq");
const dialogue = product("dialogue");
const compressor = product("compressor");
const limiter = product("limiter");
const deesser = product("deesser");
const leveler = product("leveler");
const get = (p: Product) => getAction(p);
---
<Base
  title="Altvane: audio plug-ins, nothing approximate"
  description="Altvane makes an equalizer, a dialogue isolator, a compressor, a limiter, a de-esser and a vocal rider. Free and open source, for macOS, Windows and Linux."
>
  <section class="sheet hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">Nothing approximate.</h1>
      <p class="t-lead">
        Altvane makes an equalizer, a dialogue isolator, a compressor, a limiter, a de-esser and a vocal rider. Each
        one shows you what it is doing to the audio. Free and open source, for macOS, Windows and Linux.
      </p>
      <div class="hero__programme">
        <Programme />
        <p class="t-small">VST3, AU, LV2 and Standalone, free. Released versions come from GitHub Releases; the rest build from source.</p>
      </div>
    </div>
    <div class="hero__figure">
      <EqFigure
        interactive
        class="eq-figure--bleed"
        label="Altvane EQ's response drawn as 32 concentric arcs, one per frequency from 20 Hz to 20 kHz. The length of each arc is the gain at that frequency. Use the arrow keys to move band 4."
      >
        Altvane EQ, five bands. Each arc is one frequency, 20&nbsp;Hz at the centre to 20&nbsp;kHz at the edge; its
        length is the gain, computed from the filter coefficients. Move over it to tune band&nbsp;4.
      </EqFigure>
    </div>
  </section>

  <section class="sheet series series--eq" data-product="eq" aria-labelledby="eq-title">
    <div class="series__head">
      <h2 id="eq-title" class="t-display">EQ</h2>
      <p class="series__kind t-label">{eq.kind}</p>
    </div>
    <div class="series__text">
      <p class="t-lead">{eq.summary}</p>
      <Readings items={eq.readings} />
      <div class="series__actions">
        <a class="action" href={`/${eq.code}`}>About {eq.name} <Arrow /></a>
        <a class="action action--quiet" href={get(eq).href} data-external={get(eq).arrow === "out" ? "" : undefined}>{get(eq).label} <Arrow dir={get(eq).arrow} /></a>
      </div>
    </div>
    <div class="series__figure series__figure--eq">
      <EqFigure
        preset="voice"
        class="eq-figure--bleed"
        label="A second Altvane EQ setting drawn as arcs: a high-pass at 80 Hz, a cut at 260 Hz and a lift at 5.2 kHz."
      >
        A voice: a high-pass at 80&nbsp;Hz, a cut at 260&nbsp;Hz and a lift at 5.2&nbsp;kHz.
      </EqFigure>
    </div>
  </section>

  <section class="sheet series series--dialogue" data-product="dialogue" aria-labelledby="dialogue-title">
    <div class="series__figure">
      <DialogueFigure rows={22} />
    </div>
    <div class="series__head">
      <h2 id="dialogue-title" class="t-display">Dialogue</h2>
      <p class="series__kind t-label">{dialogue.kind}</p>
    </div>
    <div class="series__text">
      <p class="t-lead">{dialogue.summary}</p>
      <Readings items={dialogue.readings} />
      <div class="series__actions">
        <a class="action" href={`/${dialogue.code}`}>About {dialogue.name} <Arrow /></a>
        <a class="action action--quiet" href={get(dialogue).href} data-external={get(dialogue).arrow === "out" ? "" : undefined}>{get(dialogue).label}, macOS and Windows <Arrow dir={get(dialogue).arrow} /></a>
      </div>
    </div>
  </section>

  <section class="sheet series series--compressor" data-product="compressor" aria-labelledby="compressor-title">
    <div class="series__head">
      <h2 id="compressor-title" class="t-display">Compressor</h2>
      <p class="series__kind t-label">{compressor.kind}</p>
    </div>
    <div class="series__text">
      <p class="t-lead">{compressor.summary}</p>
      <Readings items={compressor.readings} />
      <div class="series__actions">
        <a class="action" href={`/${compressor.code}`}>About {compressor.name} <Arrow /></a>
        <a class="action action--quiet" href={get(compressor).href} data-external={get(compressor).arrow === "out" ? "" : undefined}>{get(compressor).label} <Arrow dir={get(compressor).arrow} /></a>
      </div>
    </div>
    <div class="series__figure">
      <CompressorFigure />
    </div>
  </section>

  <section class="sheet series series--limiter" data-product="limiter" aria-labelledby="limiter-title">
    <div class="series__figure">
      <LimiterFigure />
    </div>
    <div class="series__head">
      <h2 id="limiter-title" class="t-display">Limiter</h2>
      <p class="series__kind t-label">{limiter.kind}</p>
    </div>
    <div class="series__text">
      <p class="t-lead">{limiter.summary}</p>
      <Readings items={limiter.readings} />
      <div class="series__actions">
        <a class="action" href={`/${limiter.code}`}>About {limiter.name} <Arrow /></a>
        <a class="action action--quiet" href={get(limiter).href} data-external={get(limiter).arrow === "out" ? "" : undefined}>{get(limiter).label} <Arrow dir={get(limiter).arrow} /></a>
      </div>
    </div>
  </section>

  <section class="sheet series series--deesser" data-product="deesser" aria-labelledby="deesser-title">
    <div class="series__head">
      <h2 id="deesser-title" class="t-display">De-Esser</h2>
      <p class="series__kind t-label">{deesser.kind}</p>
    </div>
    <div class="series__text">
      <p class="t-lead">{deesser.summary}</p>
      <Readings items={deesser.readings} />
      <div class="series__actions">
        <a class="action" href={`/${deesser.code}`}>About {deesser.name} <Arrow /></a>
        <a class="action action--quiet" href={get(deesser).href} data-external={get(deesser).arrow === "out" ? "" : undefined}>{get(deesser).label} <Arrow dir={get(deesser).arrow} /></a>
      </div>
    </div>
    <div class="series__figure">
      <DeEsserFigure />
    </div>
  </section>

  <section class="sheet series series--leveler" data-product="leveler" aria-labelledby="leveler-title">
    <div class="series__figure">
      <LevelerFigure />
    </div>
    <div class="series__head">
      <h2 id="leveler-title" class="t-display">Leveler</h2>
      <p class="series__kind t-label">{leveler.kind}</p>
    </div>
    <div class="series__text">
      <p class="t-lead">{leveler.summary}</p>
      <Readings items={leveler.readings} />
      <div class="series__actions">
        <a class="action" href={`/${leveler.code}`}>About {leveler.name} <Arrow /></a>
        <a class="action action--quiet" href={get(leveler).href} data-external={get(leveler).arrow === "out" ? "" : undefined}>{get(leveler).label} <Arrow dir={get(leveler).arrow} /></a>
      </div>
    </div>
  </section>

  <section class="sheet open" aria-labelledby="open-title">
    <h2 id="open-title" class="t-headline open__title">Free. Every line of it open.</h2>
    <div class="open__text">
      <p class="t-body">
        Every Altvane plug-in is free, under the GNU Affero General Public License v3. No account, no licence key, no
        trial: download it and it runs.
      </p>
      <p class="t-body">
        The source, the build, the tests and the release workflow are public. Every release is built in CI from its
        tag, for each platform the plug-in runs on: macOS, Windows and Linux, on Intel and Arm.
      </p>
      <a class="action" href={REPO} data-external>Read the source <Arrow dir="out" /></a>
    </div>
  </section>

  <section class="sheet platforms" aria-labelledby="platforms-title">
    <div class="platforms__head">
      <h2 id="platforms-title" class="t-title">Release builds</h2>
      <p class="t-small">
        Altvane Dialogue runs on macOS 11 or newer and on Windows x64 for now. There are no AAX builds yet.
      </p>
    </div>
    <div class="platforms__table">
      <Builds />
    </div>
  </section>
</Base>

<style>
  .hero {
    /* the first viewport, or more when the programme needs it */
    min-height: clamp(640px, calc(100svh - 84px), 940px);
    padding-top: clamp(40px, 7vh, 88px);
    position: relative;
  }
  .hero__copy {
    grid-column: 1 / span 5;
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    position: relative;
    z-index: 1;
    padding-bottom: var(--s7);
  }
  .hero__title {
    font-stretch: 122%;
    font-weight: 320;
    font-size: clamp(2.75rem, 5.2vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    text-wrap: balance;
    max-width: 10ch;
  }
  .hero__programme {
    margin-top: auto;
    display: grid;
    gap: var(--s4);
    max-width: 30rem;
  }
  .hero__figure {
    grid-column: 6 / span 7;
    margin-right: calc(-1 * var(--margin));
    margin-top: calc(-1 * clamp(40px, 7vh, 88px));
    position: relative;
  }
  .hero__figure :global(.eq-figure--bleed) {
    --bleed: 136%;
  }

  /* ---- the series: one sheet per plug-in, same grid, different figure ---- */
  .series {
    margin-top: var(--s10);
    padding-top: var(--s5);
    position: relative;
    row-gap: var(--s6);
    align-items: start;
  }
  .series::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--margin);
    right: var(--margin);
    border-top: 1.5px solid var(--spot);
  }
  .series__head {
    display: grid;
    gap: var(--s3);
  }
  .series__kind {
    color: var(--ink-2);
  }
  .series__text {
    display: grid;
    gap: var(--s6);
    align-content: start;
  }
  .series__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s6);
  }
  .series__actions .action {
    min-width: 15rem;
  }

  .series--eq .series__head { grid-column: 1 / span 5; }
  .series--eq .series__text { grid-column: 1 / span 5; }
  .series--eq .series__figure {
    grid-column: 7 / span 6;
    grid-row: 1 / span 2;
    align-self: stretch;
    min-height: 520px;
    margin-right: calc(-1 * var(--margin));
    position: relative;
  }
  .series__figure--eq :global(.eq-figure--bleed) {
    position: absolute;
    inset: 0;
    --bleed: 180%;
  }
  /* mirrored, with its centre pushed past the sheet edge: the arcs run off the page and the shortest,
     high-passed ones stay out of sight */
  .series__figure--eq :global(.eq-art) {
    left: auto !important;
    right: -34%;
    transform: scaleX(-1);
  }
  .series__figure--eq :global(.eq-caption) {
    right: auto;
    left: 0;
    bottom: 0;
    padding: var(--s3) var(--s4) 0 0;
  }

  .series--dialogue .series__figure { grid-column: 1 / span 7; grid-row: 1 / span 2; }
  .series--dialogue .series__head { grid-column: 9 / span 4; }
  .series--dialogue .series__text { grid-column: 9 / span 4; }

  .series--compressor .series__head { grid-column: 1 / span 5; }
  .series--compressor .series__text { grid-column: 1 / span 5; }
  .series--compressor .series__figure { grid-column: 7 / span 6; grid-row: 1 / span 2; }

  .series--limiter .series__figure { grid-column: 1 / span 7; grid-row: 1 / span 2; }
  .series--limiter .series__head { grid-column: 9 / span 4; }
  .series--limiter .series__text { grid-column: 9 / span 4; }

  .series--deesser .series__head { grid-column: 1 / span 5; }
  .series--deesser .series__text { grid-column: 1 / span 5; }
  .series--deesser .series__figure { grid-column: 7 / span 6; grid-row: 1 / span 2; }

  .series--leveler .series__figure { grid-column: 1 / span 7; grid-row: 1 / span 2; }
  .series--leveler .series__head { grid-column: 9 / span 4; }
  .series--leveler .series__text { grid-column: 9 / span 4; }

  .series .t-display {
    font-size: clamp(2.75rem, 5.6vw, 5rem);
  }

  /* ---- open source ---- */
  .open {
    margin-top: var(--s10);
    padding-top: var(--s9);
    border-top: 1px solid var(--rule);
    row-gap: var(--s6);
  }
  .open__title {
    grid-column: 1 / span 6;
    max-width: 14ch;
  }
  .open__text {
    grid-column: 8 / span 5;
    display: grid;
    gap: var(--s5);
    justify-items: start;
    padding-top: var(--s2);
  }

  /* ---- platforms ---- */
  .platforms {
    margin-top: var(--s9);
    row-gap: var(--s5);
  }
  .platforms__head {
    grid-column: 1 / span 4;
    display: grid;
    gap: var(--s3);
    align-content: start;
  }
  .platforms__head p {
    max-width: 30ch;
  }
  .platforms__table {
    grid-column: 6 / span 7;
    min-width: 0;
  }

  @media (max-width: 900px) {
    .series .series__head,
    .series .series__text,
    .series--dialogue .series__figure,
    .series--compressor .series__figure,
    .series--limiter .series__figure,
    .series--deesser .series__figure,
    .series--leveler .series__figure,
    .open__title,
    .open__text,
    .platforms__head,
    .platforms__table {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .series--dialogue .series__figure,
    .series--limiter .series__figure,
    .series--leveler .series__figure {
      order: 3;
    }
    .series--eq .series__figure {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 0;
      order: 3;
      margin-right: calc(-1 * var(--margin));
    }
    .series__figure--eq :global(.eq-figure--bleed) {
      position: relative;
      height: auto;
    }
    .series__figure--eq :global(.eq-figure--bleed .eq-art) {
      position: relative;
      height: 300px;
      width: auto;
      aspect-ratio: auto;
      right: auto;
      transform: none;
      overflow: hidden;
    }
    .series__figure--eq :global(.eq-figure--bleed .eq-art svg) {
      /* the arcs' centre sits just past the sheet's bottom-right corner */
      position: absolute;
      right: -80px;
      bottom: -40px;
      width: 560px;
      height: 560px;
      max-width: none;
      transform: scaleX(-1);
    }
    .series__figure--eq :global(.eq-figure--bleed .eq-caption) {
      position: static;
      background: none;
      padding: var(--s4) var(--margin) 0 0;
      max-width: none;
    }

    /* the hero reads title, claim, figure, then the downloads */
    .hero {
      min-height: 0;
      row-gap: var(--s5);
    }
    .hero__copy {
      display: contents;
    }
    .hero__copy > * {
      grid-column: 1 / -1;
    }
    .hero__programme {
      order: 4;
      margin-top: 0;
      max-width: none;
    }
    .hero__figure {
      grid-column: 1 / -1;
      order: 3;
      margin: 0 calc(-1 * var(--margin)) 0 0;
    }
    .hero__figure :global(.eq-figure--bleed) {
      height: auto;
      overflow: visible;
    }
    .hero__figure :global(.eq-figure--bleed .eq-art) {
      position: relative;
      overflow: hidden;
      width: 100%;
      height: min(92vw, 440px);
    }
    .hero__figure :global(.eq-figure--bleed .eq-art svg) {
      width: auto;
      height: 130%;
      margin-top: -30%;
    }
    .hero__figure :global(.eq-figure--bleed .eq-caption) {
      position: static;
      background: none;
      padding: var(--s4) var(--margin) 0 0;
      max-width: none;
    }
  }
</style>
