# Altvane EQ's audio engine is ZL Equalizer 2's, vendored unmodified.
# scripts/check_upstream.sh eq   verifies the vendored code matches this pin (CI runs it)
# scripts/sync_upstream.sh eq    moves the pin and re-vendors (read by bash: keep it KEY="value")

# where the engine comes from, and the commit it is vendored at
REPO="https://github.com/ZL-Audio/ZLEqualizer"
COMMIT="3ce598ee065b3d3847121e76e196feda7ed8f56d"

# upstream directories copied byte-for-byte into products/eq/<same path>
VENDORED="source/dsp source/zlp source/chore"

# upstream submodules pinned at the same commit in products/eq/<same path>
SUBMODULES="zldsp_fft"

# upstream submodules Altvane shares across products in third_party/<name>: reported on sync, never moved
SHARED_SUBMODULES="JUCE highway nlopt"

# upstream files Altvane EQ adapted rather than vendored: sync lists their upstream changes for porting by hand
WATCH="source/PluginProcessor.cpp source/PluginProcessor.hpp source/state CMakeLists.txt"
